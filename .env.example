# ==============================
# SocioChat Backend Configuration  
# ==============================

# Flask
SECRET_KEY=your-secret-key-change-this
SQLALCHEMY_DATABASE_URI=sqlite:///sociochat.db
# For PostgreSQL: SQLALCHEMY_DATABASE_URI=postgresql://user:pass@localhost:5432/sociochat

# SMTP (optional - for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@sociochat.com

# App URLs
APP_BASE_URL=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Public URL for Meta webhooks (use ngrok HTTPS URL when testing locally)
# Run: scripts/start-local-webhook.ps1
WEBHOOK_PUBLIC_URL=

# Meta Embedded Signup config ID (from Meta App Dashboard)
WHATSAPP_CONFIG_ID=
WHATSAPP_USE_EMBEDDED_SIGNUP=true

# Aliases (some routes use FB_* instead of META_*)
FB_APP_ID=
FB_APP_SECRET=

# Admin
ADMIN_EMAILS=admin@sociochat.com

# JWT Auth
JWT_EXPIRY_HOURS=168

# ==============================
# WhatsApp / Meta Configuration
# ==============================

# Meta App Credentials (from developers.facebook.com)
META_APP_ID=
META_APP_SECRET=

# WhatsApp Webhook Verification Token (you define this)
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# WhatsApp Encryption Key (for token encryption at rest)
WHATSAPP_ENCRYPTION_KEY=

# ==============================
# AI / LLM Configuration
# ==============================

# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key (optional, for template rewriting)
OPENAI_API_KEY=

# ==============================
# Google Services (optional)
# ==============================

# Google Service Account JSON (for Sheets integration in drip campaigns)
SERVICE_ACCOUNT_JSON=

# ==============================
# Storage (optional)
# ==============================

# AWS S3 / compatible storage for media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
